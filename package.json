{
  "name": "@agledger/mcp-server",
  "version": "2.8.0",
  "description": "AGLedger MCP Server: thin API pass-through for AI agents via MCP protocol",
  "license": "SEE LICENSE IN LICENSE",
  "author": "AGLedger LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agledger-ai/mcp-server.git"
  },
  "homepage": "https://agledger.ai",
  "keywords": [
    "agledger",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "accountability",
    "audit"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "agledger-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "deps:lag": "node scripts/dep-lag.mjs",
    "deps:refresh": "npm update && node scripts/dep-lag.mjs",
    "lint:pkg": "publint --strict && attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution",
    "prepublishOnly": "npm run build && npm run lint:pkg"
  },
  "dependencies": {
    "@agledger/verify-core": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@types/node": "^24.0.0",
    "cborg": "^6.1.1",
    "publint": "^0.3.21",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
