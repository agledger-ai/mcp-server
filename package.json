{
  "name": "@agledger/mcp-server",
  "version": "2.4.10",
  "description": "AGLedger MCP Server — Thin API pass-through for AI agents via MCP protocol",
  "license": "SEE LICENSE IN LICENSE",
  "author": "AGLedger LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/agledger-ai/mcp-server"
  },
  "homepage": "https://agledger.ai",
  "keywords": [
    "agledger",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "accountability",
    "audit"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "agledger-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@agledger/verify-core": "^0.1.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "cborg": "^5.1.1",
    "typescript": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
