{
  "name": "@agledger/mcp-server",
  "version": "3.2.0",
  "description": "AGLedger MCP server: the AGLedger API as MCP tools, so any MCP-capable agent can write to the signed ledger. Patent pending.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "AGLedger LLC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agledger-ai/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/agledger-ai/mcp-server/issues"
  },
  "homepage": "https://agledger.ai",
  "keywords": [
    "agledger",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "accountability",
    "audit"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "bin": {
    "agledger-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "prepack": "node -e \"fs.existsSync('tsconfig.json')&&child_process.execSync('npm run build',{stdio:'inherit'})\"",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "oxlint --type-aware .",
    "test": "vitest run",
    "deps:lag": "node scripts/dep-lag.mjs",
    "deps:refresh": "npm update && node scripts/dep-lag.mjs",
    "lint:pkg": "publint --strict && attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution",
    "prepublishOnly": "npm run build && npm run lint:pkg"
  },
  "dependencies": {
    "@agledger/verify-core": "^2.2.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.0.0",
    "cborg": "7.0.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "publint": "^0.3.21",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
